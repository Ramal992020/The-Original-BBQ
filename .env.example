# Copy to .env for local Node. It is automatically loaded and must NEVER be committed.
# On Vercel/Render, use the hosting project's private Environment Variables instead.
# Existing hosting variables always take precedence over the local file.

# OWNER — required once, including when customers already exist.
# The password is scrypt-hashed on the server, never shown by the public API/UI.
ADMIN_EMAIL=aliielramal@gmail.com
ADMIN_PASSWORD=
# Alternative to ADMIN_PASSWORD: a precomputed scrypt salt:hash, stored privately.
# ADMIN_PASSWORD_HASH=
# Changing these values does NOT reset a password that was changed in the dashboard.
# Until then, ADMIN_PASSWORD is re-applied on every boot -> recovery by redeploying.
# To change it later, use Account -> Change password.
# Optional: provision/refresh the supervisor account from the environment.
# SUPERVISOR_EMAIL=supervisor@your-domain.com
# SUPERVISOR_PASSWORD=

# PERSISTENT DATABASE — step-by-step setup: docs/SUPABASE.md (recommended) or docs/VERCEL-UPSTASH.md (legacy)
# Verify everything before deploying:  npm run check:env -- --vercel
# Vercel/serverless REQUIRES a persistent external database. No /tmp fallback.
# Supabase PostgreSQL (recommended). These are server-side only — never in the browser.
# STORAGE=postgres                      # postgres | redis | file — leave empty for auto-detect
# SUPABASE_URL=                         # https://xxxx.supabase.co (Project Settings → API)
# SUPABASE_SERVICE_ROLE_KEY=            # the SECRET service_role key (never the anon key)
# Legacy alternative: Upstash Redis REST credentials (used only when Supabase is not configured)
# UPSTASH_REDIS_REST_URL=               # https REST URL, not redis://
# UPSTASH_REDIS_REST_TOKEN=
# REDIS_PREFIX=bbq:
# Use separate databases/projects or prefixes for production and previews/tests.
# Local/VPS file storage: ONE Node process and a persistent disk only.
# BBQ_DATA_DIR=/var/data/bbq/data
# BBQ_UPLOAD_DIR=/var/data/bbq/uploads

# SERVER / PUBLIC URL
# PORT=3000
# HOST=0.0.0.0
# APP_URL=https://your-app.vercel.app

# PRODUCTION DEFAULTS — never publish known demo credentials or simulate real payment.
DEMO_LOGIN=0
SEED_DEMO=0
ALLOW_DEMO_PAYMENTS=0
ALLOW_CONSOLE_MAIL=0
# Test fixtures require SEED_DEMO=1 locally, outside production/serverless.
# Demo quick login additionally requires DEMO_LOGIN=1; only a customer is allowed.
# Demo payment requires ALLOW_DEMO_PAYMENTS=1 locally, outside production/serverless.
# Console reset mail requires ALLOW_CONSOLE_MAIL=1 locally and is NOT real email.

# REAL PASSWORD-RESET EMAIL (optional; otherwise recovery reports unavailable)
# RESEND_API_KEY=
# MAIL_FROM=BBQ <no-reply@your-verified-domain.com>

# OPTIONAL IMAGE GENERATION — bundled image library works without a key.
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# Payment and WhatsApp provider keys are configured privately in the admin dashboard.
# Real orders work with cash on delivery and IN-APP admin notifications, without them.
# Online payment stays unavailable until Stripe/Paymob is configured.
# WhatsApp stays disabled until the restaurant explicitly enables/configures it.
