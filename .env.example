# =============================================================================
#  .env.example — كل متغيرات البيئة اللي المشروع بيفهمها
#  انسخه لـ .env للتشغيل المحلي، أو حط القيم في لوحة Vercel / Render.
#  ⚠️ ملف .env نفسه متحطوش في Git (متنساش في .gitignore).
#  ملاحظة: السيرفر بيقرأ process.env مباشرة — لتشغيل محلي سريع تقدر كمان
#  تكتب المتغيرات قبل الأمر:  APP_URL=... DEMO_LOGIN=0 npm start
# =============================================================================

# -----------------------------------------------------------------------------
#  ١) التخزين — السيرفر بيختار الوضع لوحده
#     لو UPSTASH_REDIS_REST_URL موجود → redis (سيرفرلس)
#     غير كده → file (ملفات JSON في server/data)
#
#     ⚠️ على Vercel التخزين في /tmp بيضيع مع كل Deploy — من غير Upstash
#        البيانات مش دائمة. الشرح الكامل: docs/VERCEL-UPSTASH.md
# -----------------------------------------------------------------------------
# STORAGE=redis                        # redis | file  (اختياري — لتجاوز الاختيار التلقائي)
# UPSTASH_REDIS_REST_URL=              # إجباري على Vercel — لازم رابط REST (https://...) مش redis://
# UPSTASH_REDIS_REST_TOKEN=            # إجباري معاه
# REDIS_PREFIX=bbq:                    # لو هتشغّل أكتر من تطبيق على نفس قاعدة Redis
# BBQ_DATA_DIR=                        # مكان ملفات JSON (وضع السيرفر العادي)
# BBQ_UPLOAD_DIR=                      # مكان الصور المرفوعة (وضع السيرفر العادي)

# -----------------------------------------------------------------------------
#  ٢) السيرفر العادي (محلي / VPS / Render)
# -----------------------------------------------------------------------------
# PORT=3000
# HOST=0.0.0.0

# -----------------------------------------------------------------------------
#  ٣) الروابط الخارجية — بيستخدم في: رابط الدفع، رسائل واتساب، استعادة كلمة السر
#     لازم يبقى الدومين النهائي بالـ https ومن غير / في الآخر
# -----------------------------------------------------------------------------
# APP_URL=https://your-app.vercel.app

# -----------------------------------------------------------------------------
#  ٣.٥) بيانات دخول الأدمن — ⭐ إجباري على Vercel
#     لو ADMIN_PASSWORD متظبط، كلمة سر الأدمن بتبقى هي دي مع كل إقلاع (Redeploy).
#     من غيره الحساب بيفضل بـ admin123 وده خطر على الإنتاج.
#     استرجاع الدخول لو نسيتها: غيّر المتغير → Redeploy → ادخل بالجديدة.
# -----------------------------------------------------------------------------
# ADMIN_PASSWORD=                      # ٨ حروف على الأقل
# ADMIN_EMAIL=admin@bbq.app            # اختياري — إيميل الأدمن
# SUPERVISOR_PASSWORD=                 # اختياري — نفس الفكرة لحساب المشرف

# -----------------------------------------------------------------------------
#  ٤) الأمان — قبل أي استخدام حقيقي
# -----------------------------------------------------------------------------
DEMO_LOGIN=0                           # 0 = يقفل زر «الدخول السريع» للحساب التجريبي
# DEMO_USER_ID=                        # لو عايز الدخول السريع يدخل بحساب معين

# -----------------------------------------------------------------------------
#  ٤.٥) فحص الجاهزية قبل النشر (مش متغير — أمر)
#       npm run check:env -- --vercel
#       بيقولك إيه الناقص وإيه الغلط + بيعمل PING تجريبي على Upstash.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
#  ٥) توليد الصور بالذكاء الاصطناعي (اختياري)
#     من غير أي مفتاح → بيشتغل من المكتبة المدمجة (١٨ صورة جاهزة)
# -----------------------------------------------------------------------------
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# -----------------------------------------------------------------------------
#  ٦) الإيميل (اختياري) — لاستعادة كلمة السر الحقيقية
#     من غير مفتاح → الإيميل بيتطبع في لوجات السيرفر
# -----------------------------------------------------------------------------
# RESEND_API_KEY=
# MAIL_FROM=no-reply@yourdomain.com

# -----------------------------------------------------------------------------
#  ٧) مفاتيح الدفع والواتساب ❗
#     دي **مش** متغيرات بيئة — بتتحط من لوحة الإدارة (تبويب 💳 الدفع / 💬 واتساب)
#     وبتتخزّن على السيرفر بس، وبتظهر في اللوحة مقنّعة (آخر ٤ حروف).
# -----------------------------------------------------------------------------
